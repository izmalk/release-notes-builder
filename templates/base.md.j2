{# DA186-compliant release notes base template.
   Product-specific templates should {% extends "base.md.j2" %} and override
   the blocks marked "TODO" below.

   Overridable blocks:
     frontmatter   - anything above the title (e.g. MyST html_meta)
     title         - release heading
     date_line     - date line below the title
     introduction  - intro paragraph (wraps intro_links)
     intro_links   - Charmhub / Deploy / Upgrade / System requirements links
     changelog     - the whole "list of changes" section
     security      - product-specific security / CVE section
     compatibility - compatibility table
     known_issues  - known issues section (commented out by default)
     footer        - anything after the known issues section
#}
{% block frontmatter %}{% endblock %}
{% block title %}
# {{ title }}
{% endblock %}
{% block date_line %}

**{{ date }}**
{% endblock %}
